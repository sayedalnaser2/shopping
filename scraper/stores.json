{
  "_note": "search_url uses {q} for the URL-encoded query. 'parser' selects a custom reader in scrape.py. 'render' uses Chromium. Lulu and Hypermax are not here: they block automated access.",
  "ramez": {
    "enabled": true,
    "search_url": "https://ramezshopping.com/products/search/store/7263?text={q}",
    "render": true,
    "parser": "text_cards",
    "query": "name"
  },
  "jazira": {
    "enabled": true,
    "parser": "wave",
    "headers": {
      "appid": "aljazira-web"
    },
    "search_url": "https://aljazira.api.wavegrocery.com/api/v3.1/products/search?pageNumber=0&pageSize=20&term={q}&collectionTypes%5B%5D=1"
  },
  "megamart": {
    "enabled": true,
    "parser": "oscar",
    "search_url": "https://megamart.bh/en/search/?q={q}"
  }
}
